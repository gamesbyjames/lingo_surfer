# Copy this file to .env, fill in your key, and restart server.py.
# Your key stays on the Python server and is never sent to the browser.
ELEVENLABS_API_KEY=
# Optional: native Greek Stavros; add this voice to your library before generating.
ELEVENLABS_VOICE_ID=3NIJOdpOh5ailCXf4Qmi
# Greek is supported by Eleven v3.
ELEVENLABS_MODEL_ID=eleven_v3
